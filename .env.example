# Veblix — приклад змінних середовища.
# Скопіюй у .env для локального `netlify dev`. РЕАЛЬНІ значення НЕ комітити.
# У проді ці ж змінні задаються в Netlify → Site settings → Environment variables.

# Токен Telegram-бота (перевипусти старий через @BotFather перед деплоєм!).
TELEGRAM_BOT_TOKEN=

# ID чату/каналу, куди падають заявки.
TELEGRAM_CHAT_ID=
